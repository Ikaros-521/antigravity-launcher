{
  "name": "antigravity-launcher",
  "version": "1.0.1",
  "description": "Cross-platform process-local proxy launcher for Google Antigravity",
  "main": "src/main.js",
  "author": {
    "name": "Ikaros-521",
    "email": "327209194@qq.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-icon.ps1 && node tools/make-ico.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.peroperoyui.antigravitylauncher",
    "productName": "Antigravity Launcher",
    "copyright": "MIT",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "反重力代理启动器",
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "Name": "Antigravity Launcher",
        "GenericName": "反重力代理启动器",
        "Comment": "Process-local proxy launcher for Google Antigravity",
        "StartupWMClass": "antigravity-launcher"
      }
    }
  }
}
